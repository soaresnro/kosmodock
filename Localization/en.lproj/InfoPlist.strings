"NSDownloadsFolderUsageDescription" = "Kosmodock lists this folder's files only for the folder stacks you put on the Dock.";
"NSCalendarsFullAccessUsageDescription" = "Kosmodock reads your calendars only for the Calendar widget, to show today's and tomorrow's events. It never changes them.";
"NSCalendarsUsageDescription" = "Kosmodock reads your calendars only for the Calendar widget, to show today's and tomorrow's events. It never changes them.";
"NSRemindersFullAccessUsageDescription" = "Kosmodock reads your reminders only for the Reminders widget, to show what's due. It changes one only when you mark it as completed there.";
